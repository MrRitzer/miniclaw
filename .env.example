# MiniClaw Environment Variables
# Copy this file to .env and fill in your values

# Core settings
MINICLAW_DB_PATH=~/.miniclaw/memory.db
MINICLAW_DATA_DIR=data/agent
MINICLAW_WORKSPACE_DIR=data/workspace
MINICLAW_LOG_LEVEL=INFO
MINICLAW_HEARTBEAT_INTERVAL=30

# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
MINICLAW_TELEGRAM_BOT_TOKEN=
# Comma-separated list of allowed chat IDs (leave empty to allow all)
# MINICLAW_TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321
MINICLAW_TELEGRAM_POLLING_TIMEOUT=60

# OpenAI Configuration
# Get your API key from https://platform.openai.com/api-keys
MINICLAW_OPENAI_API_KEY=
# Model to use (defaults to gpt-4o-mini)
# MINICLAW_OPENAI_MODEL=gpt-4o-mini
# Optional: Use a proxy or custom endpoint
# MINICLAW_OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Configuration
# Get your API key from https://console.anthropic.com/
MINICLAW_ANTHROPIC_API_KEY=
# Model to use (defaults to claude-sonnet-4-20250514)
# MINICLAW_ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Optional: Use a proxy or custom endpoint
# MINICLAW_ANTHROPIC_BASE_URL=https://api.anthropic.com

# GitHub Configuration (optional)
# Personal access token for watching repositories
# MINICLAW_GITHUB_TOKEN=
